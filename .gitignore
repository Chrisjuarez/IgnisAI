# ----------------------------
# Node / package managers
# ----------------------------
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.cache/
.parcel-cache/
.turbo/
.swc/
.eslintcache

# ----------------------------
# Builds & test artifacts
# ----------------------------
dist/
build/
coverage/
junit*.xml
.lcov
*.lcov

# ----------------------------
# Env & secrets
#   * Never commit any .env. The only allowed files are *.env.example.
#   * Anything that looks like a secret (PEM, p12, jks) is excluded too.
# ----------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.jks

# Docker env files
docker/env_backend
docker/tilesvc.env
tilesvc.env

# ----------------------------
# Editor / OS cruft
# ----------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# ----------------------------
# Python / data science
# ----------------------------
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ----------------------------
# IgnisAI: large data + model artifacts
#   These are regenerated by data pipelines or downloaded at runtime via
#   MODEL_URL — they should never live in git.
# ----------------------------
data/source-rasters/
data/static_pipeline/
data/firms_snapshots/
data/noaa_grid_cache/
data/prediction_cache/
.cache/static_pipeline/
models/*.pt
models/*.onnx
*.nc
*.zip
*.tif
*.tiff
*.vrt

# v4 retrain bulk data (lives on external drive via IGNIS_DATA_ROOT)
data/tssatfire_raw/
data/tssatfire_500m_T6/
data/mNDWS_500m_T6/
data/perimeters/
models/eval/
*.tar.gz
research/wsts/third_party/

# --- staged rollout rules (top of file) ---
# Ignore everything under backend & frontend now…
backend/**
frontend/**
!backend/__tests__/
!backend/__tests__/**
!backend/
!backend/models/
!backend/models/Wildfire.js
# …but allow package manifests so CI can exist without app code:
!backend/
!frontend/
!backend/package.json
!backend/package-lock.json
!frontend/package.json
!frontend/package-lock.json
!backend/app.js
!backend/jest.config.cjs
!backend/__tests__/**

# Keep docs/tests
!docs/**
!tests/**

# (leave your normal Node/git ignores below)
node_modules/
.env
coverage/
dist/
build/
.DS_Store!backend/.nycrc.json

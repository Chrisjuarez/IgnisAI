# backend/.env.example
# Copy to backend/.env and fill in real values. Never commit the real file.

# ---- Server ----
PORT=5000
NODE_ENV=development

# CORS: comma-separated list of allowed origins. The backend always allows
# the production frontend + localhost; this var adds extras (e.g. preview
# deploys). Do NOT set CORS_ORIGIN=* in production.
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# Local mongo (docker-compose) or Atlas — pick one.
MONGODB_URI=mongodb://localhost:27017/ignisai

# ---- Auth ----
# REQUIRED in production. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- External data sources ----
# NASA FIRMS API token (https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_API_KEY=

# Mapbox SECRET token (sk.*) — server-side only. The frontend uses a
# separate public token (pk.*); never put a sk.* token in the React build.
MAPBOX_ACCESS_TOKEN=

# ---- Service wiring ----
# Local: docker-compose service name. Production: Render URL.
TILE_SVC=http://localhost:8008

# Optional internal base used by predictFireSpread retries.
INTERNAL_SELF_BASE=http://127.0.0.1:5000

# ---- AWS / object storage (optional) ----
AWS_REGION=
AWS_S3_STATIC_BUCKET=
AWS_S3_DYNAMIC_BUCKET=

# ---- Tunables ----
# Map bootstrap cache TTL in ms. Default 180000 (3 min).
MAP_BOOTSTRAP_CACHE_MS=180000
# Bound on the cache size (entries). Default 200.
MAP_BOOTSTRAP_CACHE_MAX=200
# Predict path retries on tilesvc 5xx (NOT used for /multistep). Default 2.
PREDICT_RETRY_BACKOFF_MS=750
# Hard cap for /predict-fire-spread/multistep upstream call. Default 240000.
MULTISTEP_TIMEOUT_MS=240000
# Master switch — set to false to serve observed data only.
PREDICTIONS_ENABLED=true

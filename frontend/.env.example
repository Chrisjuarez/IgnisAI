# frontend/.env.example
# Copy to frontend/.env and fill in real values. Never commit the real file.
# All REACT_APP_* vars are baked into the JS bundle at build time and are
# therefore PUBLIC — only put public tokens here.

# Mapbox PUBLIC token (pk.*). NEVER put a sk.* token here.
REACT_APP_MAPBOX_TOKEN=

# Backend API URL.
#   * Local dev (CRA proxy):  /api
#   * Local docker-compose:   http://localhost:5000/api
#   * Production:             https://ignisai-backend.onrender.com/api
REACT_APP_API_URL=/api

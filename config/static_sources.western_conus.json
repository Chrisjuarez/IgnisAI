  "channels": {
    "elev": {
      "type": "raster",
      "uri": "s3://ignisai-static-chrisjuarez-2026/source-data/topography/srtm_dem_western_conus_500m.tif",
      "units": "m",
      "valid_range": [
        -100,
        4500
      ],
      "resampling": "bilinear",
      "runtime_resampling": "bilinear",
      "source": {
        "name": "NASA SRTM v3 1 arc-second DEM, Western CONUS 500 m COG",
        "url": "https://data.naturalcapitalalliance.stanford.edu/download/global/nasa-srtm-v3-1s/srtm-v3-1s.tif",
        "note": "Used as the buildable DEM source until a USGS 3DEP Western CONUS COG mosaic is prepared."
      }
    },
    "ndvi": {
      "type": "raster",
      "uri": "s3://ignisai-static-chrisjuarez-2026/source-data/ndvi/noaa_star_smn_ndvi_jun_nov_2024_western_conus_500m.tif",
